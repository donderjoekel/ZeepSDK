<Project>
  <!--
    BepInEx.PluginInfoProps writes obj/**/MyPluginInfo.cs as a public type with no XML comments.
    GenerateDocumentationFile + TreatWarningsAsErrors turns that into CS1591.
    Rewrite the file with a pragma so the package can stay as-is.
  -->
  <Target Name="SuppressMyPluginInfoDocWarnings" AfterTargets="AddGeneratedFile">
    <PropertyGroup>
      <_MyPluginInfoWithPragma><![CDATA[
// <auto-generated />
#pragma warning disable CS1591
namespace $(RootNamespace)
{
    public static class MyPluginInfo
    {
        public const string PLUGIN_GUID = "$(BepInExPluginGuid)"%3B
        public const string PLUGIN_NAME = "$(BepInExPluginName)"%3B
        public const string PLUGIN_VERSION = "$(BepInExPluginVersion)"%3B
    }
}
]]></_MyPluginInfoWithPragma>
    </PropertyGroup>
    <WriteLinesToFile Lines="$(_MyPluginInfoWithPragma)" File="$(GeneratedFilePath)" WriteOnlyWhenDifferent="true" Overwrite="true" />
  </Target>
</Project>
